{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "botvoda",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chabany-water-bot-db",
      "database_id": "1f2002ba-8349-4a89-bc7f-234b15e75c54"
    }
  ],
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULE_CARD_RENDERER",
        "class_name": "ScheduleCardRenderer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "schedule-card-v1",
      "new_sqlite_classes": [
        "ScheduleCardRenderer"
      ]
    }
  ],
  "previews": {
    "vars": {
      "PREVIEW_MODE": "on",
      "SCHEDULE_CARD_ENABLED": "off",
      "DTEK_AUTO_SYNC": "off"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "SCHEDULE_CARD_RENDERER",
          "class_name": "ScheduleCardRenderer"
        }
      ]
    },
    "d1_databases": []
  }
}
